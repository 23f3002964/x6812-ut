ACTION=="add", KERNEL=="stpgps", GROUP="gps", MODE="0660"
ACTION=="add", KERNEL=="gps", GROUP="gps", MODE="0660"
ACTION=="add", KERNEL=="fw_log_gps", GROUP="gps", MODE="0660"
ACTION=="add", KERNEL=="gps_emi", GROUP="gps", MODE="0660"
ACTION=="add", KERNEL=="stpant", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add", KERNEL=="wmtWifi", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="fw_log_wifi", MODE="0660"
ACTION=="add", KERNEL=="fm", MODE="0660"
ACTION=="add", KERNEL=="msr3110", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="mt6605", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="st21nfc", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="btif", OWNER="system", GROUP="system", MODE="0600"
ACTION=="add", KERNEL=="trusty-ipc-dev0", OWNER="system", GROUP="system", MODE="0660"
