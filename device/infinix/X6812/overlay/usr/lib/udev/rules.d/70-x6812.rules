ACTION=="add", KERNEL=="block/platform/bootdevice/by-name/md1img_1", OWNER="root", GROUP="system", MODE="0640"
ACTION=="add", KERNEL=="block/platform/bootdevice/by-name/md1img_a", OWNER="root", GROUP="system", MODE="0640"
