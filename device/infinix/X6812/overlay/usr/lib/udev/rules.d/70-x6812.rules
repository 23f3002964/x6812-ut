ACTION=="add", KERNEL=="mtk_dfrc", OWNER="system", GROUP="android_graphics", MODE="0660"
# usip
ACTION=="add", KERNEL=="usip", OWNER="system", GROUP="android_media", MODE="0660"
# Enable KVM for all users in phablet
# Ultimately access is mediated by AppArmor
KERNEL=="kvm", GROUP="phablet", MODE="0660"

# Set torch-light permissions so indicator-power can access it
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="flashlight", RUN+="/bin/chgrp android_input /sys/class/leds/%k/brightness"
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="flashlight", RUN+="/bin/chmod g+w /sys/class/leds/%k/brightness"

# ignore second Wi-Fi interface in NetworkManager
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan1", ENV{NM_UNMANAGED}="1"
